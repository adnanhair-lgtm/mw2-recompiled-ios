name: iOS simulator build

on:
  workflow_dispatch:
    inputs:
      game_version:
        description: "Versi game yang akan dibangun"
        type: choice
        required: true
        options:
          - tu6
          - tu0
        default: tu6

permissions:
  contents: read

jobs:
  build:
    # Apple Silicon runner: builds the iOS arm64 simulator target using Xcode.
    runs-on: macos-15
    timeout-minutes: 330
    env:
      GAME_VERSION: ${{ inputs.game_version }}
      MW2_IOS_SIMULATOR: iPhone 16

    steps:
      - name: Check out this repository
        uses: actions/checkout@v6

      - name: Check private asset credentials
        env:
          ASSET_REPO: ${{ secrets.ASSET_REPO }}
          ASSET_REPO_TOKEN: ${{ secrets.ASSET_REPO_TOKEN }}
        run: |
          if [[ -z "$ASSET_REPO" || -z "$ASSET_REPO_TOKEN" ]]; then
            echo "::error::Set ASSET_REPO and ASSET_REPO_TOKEN repository secrets (the same secrets used by release.yml)."
            exit 1
          fi

      - name: Check out the private game inputs
        uses: actions/checkout@v6
        with:
          repository: ${{ secrets.ASSET_REPO }}
          token: ${{ secrets.ASSET_REPO_TOKEN }}
          path: private-assets
          persist-credentials: false

      - name: Prepare executable and update inputs
        run: |
          set -euo pipefail
          mkdir -p mw2/tu0 mw2/update
          for file in default.xex default_mp.xex; do
            test -s "private-assets/$file" || { echo "::error::Missing private-assets/$file"; exit 1; }
            cp "private-assets/$file" mw2/tu0/
          done

          if [[ "$GAME_VERSION" == "tu6" ]]; then
            update_dir=private-assets/title-updates/TU6
            for file in default.xexp default_mp.xexp patch_mp.ff dlc1_ui_mp.ff dlc2_ui_mp.ff; do
              test -s "$update_dir/$file" || { echo "::error::Missing $update_dir/$file"; exit 1; }
              cp "$update_dir/$file" mw2/update/
            done
          elif [[ "$GAME_VERSION" != "tu0" ]]; then
            echo "::error::Unsupported game version: $GAME_VERSION"
            exit 1
          fi
          rm -rf private-assets

      - name: Install build tools and MoltenVK
        env:
          MOLTENVK_VERSION: v1.4.0
        run: |
          set -euo pipefail
          brew install llvm@18 cmake ninja xcodegen
          echo "LLVM=$(brew --prefix llvm@18)/bin" >> "$GITHUB_ENV"

          mkdir -p deps/moltenvk
          curl --fail --location --silent --show-error \
            "https://github.com/KhronosGroup/MoltenVK/releases/download/${MOLTENVK_VERSION}/MoltenVK-all.tar" \
            --output "$RUNNER_TEMP/MoltenVK-all.tar"
          tar -xf "$RUNNER_TEMP/MoltenVK-all.tar" -C deps/moltenvk
          test -d deps/moltenvk/MoltenVK/MoltenVK/static/MoltenVK.xcframework

      - name: Generate both recompiled game trees
        run: |
          set -euo pipefail
          for title in sp mp; do
            VERSION="$GAME_VERSION" TITLE="$title" ONLINE=lan ./build.sh
          done

      - name: Build the iOS simulator app
        run: VERSION="$GAME_VERSION" ONLINE=lan ./ios/build.sh sim

      - name: Package simulator app artifact
        run: |
          set -euo pipefail
          app_dir=build-ios-derived/Build/Products/Release-iphonesimulator
          test -d "$app_dir/MW2.app"
          tar -czf "$RUNNER_TEMP/MW2-simulator-app.tar.gz" -C "$app_dir" MW2.app

      - name: Upload simulator app
        uses: actions/upload-artifact@v6
        with:
          name: mw2-ios-simulator-${{ inputs.game_version }}
          path: ${{ runner.temp }}/MW2-simulator-app.tar.gz
          if-no-files-found: error
          compression-level: 0
          retention-days: 7
